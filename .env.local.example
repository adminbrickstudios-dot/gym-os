# ═══════════════════════════════════════════════════════════════════
# Gym OS — variables de entorno
# Copiá este archivo a .env.local y completalo. .env.local NUNCA se
# commitea. Las NEXT_PUBLIC_* se inlinean en el build: cambiarlas en
# Vercel no hace nada hasta el próximo deploy.
# ═══════════════════════════════════════════════════════════════════


# ── Supabase ────────────────────────────────────────────────────────

# URL del proyecto.
# Dónde: Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública. Va al navegador; RLS es lo que protege los datos.
# Dónde: Supabase → Project Settings → API → anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio. SALTEA RLS. Solo en el servidor, nunca con NEXT_PUBLIC.
# Dónde: Supabase → Project Settings → API → service_role
# Vercel: solo Production (y Preview si hay base de preview).
SUPABASE_SERVICE_ROLE_KEY=

# Cadena de conexión para migraciones y generación de tipos.
# Dónde: Supabase → Project Settings → Database → Connection string → Session pooler
# La contraseña de la base: SOLO letras y números. Un @ o un # rompe la
# cadena y el error no lo dice.
# No va a Vercel: la usan los scripts locales.
SUPABASE_DB_URL=


# ID del proyecto (para npm run db:types; antes: npx supabase login).
# Dónde: Supabase → Project Settings → General → Project ID
SUPABASE_PROJECT_ID=

# ── Dominios ────────────────────────────────────────────────────────

# Dominio base de los subdominios de cada gimnasio. Sin protocolo.
# Ej: midominio.com → olympo.midominio.com
NEXT_PUBLIC_DOMINIO_BASE=

# Host del panel de plataforma (topside) y la landing de BRIK.
# Ej: app.midominio.com
NEXT_PUBLIC_DOMINIO_PLATAFORMA=


# ── Vercel (alta de dominios propios por API) ──────────────────────

# Token con scope del TEAM, no personal.
# Dónde: Vercel → Account Settings → Tokens → Create (scope: el team)
VERCEL_API_TOKEN=

# Dónde: Vercel → Project → Settings → General → Project ID
VERCEL_PROJECT_ID=

# OBLIGATORIO si el proyecto está en un team. Sin él la API devuelve
# 403 con un token válido.
# Dónde: Vercel → Team Settings → General → Team ID
VERCEL_TEAM_ID=


# ── Seguridad interna ──────────────────────────────────────────────

# Clave para derivar el secreto del QR rotativo de cada socio
# (HMAC(clave, socio_id + version)). Cambiarla invalida TODOS los QR.
# Generar: openssl rand -base64 48
QR_CLAVE_MAESTRA=

# Protege las rutas que llama el cron de Vercel.
# Generar: openssl rand -base64 32
CRON_SECRET=

# Secreto compartido con el "Send SMS hook" de Supabase Auth.
# Dónde: Supabase → Authentication → Hooks (se genera ahí)
SUPABASE_HOOK_SMS_SECRETO=


# ── Más adelante (dejar vacías hasta su sección) ───────────────────

# MercadoPago — flujo SUSCRIPCIÓN (BRIK cobra al gimnasio). Credenciales de BRIK.
# Dónde: MercadoPago Developers → Tus integraciones → la app de BRIK
# MP_PLATAFORMA_ACCESS_TOKEN=
# MP_PLATAFORMA_WEBHOOK_SECRETO=

# MercadoPago — flujo COBROS (el gimnasio cobra a sus socios).
# Estas NO son las credenciales del gimnasio: son las de la app de BRIK
# para el OAuth. Los tokens de cada gimnasio viven cifrados en la base.
# MP_APP_CLIENT_ID=
# MP_APP_CLIENT_SECRET=
# MP_COBROS_WEBHOOK_SECRETO=

# Mails
# Dónde: resend.com → API Keys
# RESEND_API_KEY=
# EMAIL_REMITENTE=

# Proveedor del código de login (Twilio u otro) — se carga en
# Supabase si se usa el proveedor nativo, o acá si el Send SMS hook
# envía desde nuestro código.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_REMITENTE=

# WhatsApp Cloud API (automatizaciones)
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# Notificaciones push (PUSH-1). Claves propias, sin costo.
# Se generan una vez con:  npx web-push generate-vapid-keys
# La pública va al navegador; la privada solo en el servidor (Vercel). El
# sujeto es un mail de contacto para los servicios de push.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUJETO=mailto:avisos@tu-dominio.com
