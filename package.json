{
  "name": "gym-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "db:aplicar": "node scripts/db/aplicar.mjs",
    "db:prevuelo": "node scripts/db/aplicar.mjs --prevuelo",
    "db:types": "node scripts/db/tipos.mjs",
    "db:local": "scripts/db/local.sh nueva",
    "db:pruebas": "DB_PRUEBAS_URL=$(scripts/db/local.sh url) node --test \"supabase/pruebas/*.test.mjs\"",
    "sembrar:demo": "node scripts/datos/sembrar-demo.mjs",
    "chequeos": "node scripts/chequeos.mjs",
    "verificar": "npm run lint && npm run typecheck && npm test && npm run db:pruebas && npm run chequeos && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "pg": "^8.23.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
